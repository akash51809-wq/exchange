# ==========================================
# Exchange Platform - Environment Configuration
# ==========================================

# 1. Supabase PostgreSQL Database Connection (IPv4 Pooler for Render / Cloud)
# -------------------------------------------------------------------------
# Render Free tier requires IPv4 Connection Pooler (Port 6543 or 5432):
DATABASE_URL=postgresql://postgres.vvejlrvljsodfcvhhawr:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Or Direct Connection (Port 5432):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. Supabase API Configuration (Optional / Client JS)
# ----------------------------------------------------
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=[YOUR-ANON-PUBLIC-KEY]
# SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# 3. Application Security & Admin Settings
# ----------------------------------------
# 32-byte (64 hex characters) encryption secret for sensitive database fields (passwords, encrypted credentials)
APP_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Default bootstrap password for initial admin user (username: admin)
ADMIN_BOOTSTRAP_PASSWORD=Admin@123

# 4. Server Settings
# ------------------
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
